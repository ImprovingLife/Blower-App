  <script>
/* Candle Blower — all audio synthesized with Web Audio, scene drawn on canvas. */
(() => {
  'use strict';

  const $ = (sel, root = document) => root.querySelector(sel);
  const $$ = (sel, root = document) => Array.from(root.querySelectorAll(sel));
  const TAU = Math.PI * 2;
  const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ------------------------------------------------------------------ refs */
  const canvas = $('#scene');
  const ctx = canvas.getContext('2d');
  const stage = $('#stage');
  const statusEl = $('#status');
  const statusText = $('#statusText');
  const statusFreq = $('#statusFreq');
  const captionEl = $('#stageCaption');
  const relightBtn = $('#relightBtn');
  const stopBtn = $('#stopBtn');
  const volumeEl = $('#volume');
  const volumeOut = $('#volumeOut');
  const infoBtn = $('#infoBtn');
  const infoPanel = $('#infoPanel');
  const infoClose = $('#infoClose');
  const downloadBtn = $('#downloadBtn');
  const modeEls = new Map($$('.mode').map((el) => [el.dataset.mode, el]));

  const MODES = {
    flame: { status: 'Blowing', duration: 18 },
    fan: { status: 'Cooling', duration: 120 },
    clean: { status: 'Cleaning', duration: 30 },
  };

  /* ----------------------------------------------------------------- audio */
  class ToneEngine {
    constructor(volume = 0.65) {
      this.ctx = null;
      this.master = null;
      this.analyser = null;
      this.data = null;
      this.bus = null;
      this.nodes = [];
      this.osc = null;
      this.mode = null;
      this.volume = volume;
    }

    async ensure() {
      if (!this.ctx) {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) throw new Error('Web Audio is not supported in this browser.');
        const audioCtx = new AC({ latencyHint: 'interactive' });
        const master = audioCtx.createGain();
        master.gain.value = this.volume;

        const highpass = audioCtx.createBiquadFilter();
        highpass.type = 'highpass';
        highpass.frequency.value = 20;
        highpass.Q.value = 0.6;

        const limiter = audioCtx.createDynamicsCompressor();
        limiter.threshold.value = -10;
        limiter.knee.value = 8;
        limiter.ratio.value = 12;
        limiter.attack.value = 0.003;
        limiter.release.value = 0.22;

        const analyser = audioCtx.createAnalyser();
        analyser.fftSize = 512;
        analyser.smoothingTimeConstant = 0.72;

        master.connect(highpass);
        highpass.connect(limiter);
        limiter.connect(analyser);
        analyser.connect(audioCtx.destination);

        this.ctx = audioCtx;
        this.master = master;
        this.analyser = analyser;
        this.data = new Uint8Array(analyser.fftSize);
      }
      if (this.ctx.state !== 'running') await this.ctx.resume();
    }

    setVolume(v) {
      this.volume = clamp(v, 0, 1);
      if (this.ctx) {
        this.master.gain.setTargetAtTime(this.volume, this.ctx.currentTime, 0.04);
      }
    }

    get frequency() {
      return this.osc ? this.osc.frequency.value : 0;
    }

    level() {
      if (!this.analyser) return 0;
      this.analyser.getByteTimeDomainData(this.data);
      let sum = 0;
      for (let i = 0; i < this.data.length; i += 4) {
        const v = (this.data[i] - 128) / 128;
        sum += v * v;
      }
      return Math.sqrt(sum / (this.data.length / 4));
    }

    _newBus(now, fade = 0.14) {
      const bus = this.ctx.createGain();
      bus.gain.setValueAtTime(0.0001, now);
      bus.connect(this.master);
      bus.gain.exponentialRampToValueAtTime(1, now + fade);
      return bus;
    }

    startFlame() {
      const ac = this.ctx;
      const now = ac.currentTime + 0.02;
      const bus = this._newBus(now);

      // Deep sine sweep: 30–78 Hz, settle near 44 Hz, then a second pass.
      const osc = ac.createOscillator();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(30, now);
      osc.frequency.exponentialRampToValueAtTime(78, now + 2.4);
      osc.frequency.exponentialRampToValueAtTime(44, now + 3.8);
      osc.frequency.setValueAtTime(44, now + 7.0);
      osc.frequency.exponentialRampToValueAtTime(72, now + 9.5);
      osc.frequency.exponentialRampToValueAtTime(46, now + 11.2);

      const gain = ac.createGain();
      gain.gain.value = 0.9;
      osc.connect(gain).connect(bus);

      // A little 6 Hz vibrato helps the flame dance.
      const lfo = ac.createOscillator();
      lfo.frequency.value = 6.2;
      const depth = ac.createGain();
      depth.gain.value = 1.4;
      lfo.connect(depth);
      depth.connect(osc.frequency);

      osc.start(now);
      lfo.start(now);

      this.bus = bus;
      this.nodes = [osc, lfo, gain, depth];
      this.osc = osc;
      this.mode = 'flame';
    }

    startFan() {
      const ac = this.ctx;
      const now = ac.currentTime + 0.02;
      const bus = this._newBus(now, 0.5);

      // Brown-ish noise buffer, normalized.
      const length = Math.floor(ac.sampleRate * 2);
      const buffer = ac.createBuffer(1, length, ac.sampleRate);
      const data = buffer.getChannelData(0);
      let last = 0;
      let peak = 0;
      for (let i = 0; i < length; i++) {
        const white = Math.random() * 2 - 1;
        last = (last + 0.02 * white) / 1.02;
        data[i] = last;
        peak = Math.max(peak, Math.abs(last));
      }
      const norm = peak > 0 ? 0.85 / peak : 1;
      for (let i = 0; i < length; i++) data[i] *= norm;

      const src = ac.createBufferSource();
      src.buffer = buffer;
      src.loop = true;

      const low = ac.createBiquadFilter();
      low.type = 'lowpass';
      low.frequency.value = 1200;
      low.Q.value = 0.4;

      const high = ac.createBiquadFilter();
      high.type = 'highpass';
      high.frequency.value = 110;

      const airGain = ac.createGain();
      airGain.gain.value = 0.55;

      src.connect(low).connect(high).connect(airGain).connect(bus);

      const src2 = ac.createBufferSource();
      src2.buffer = buffer;
      src2.loop = true;
      const band = ac.createBiquadFilter();
      band.type = 'bandpass';
      band.frequency.value = 2600;
      band.Q.value = 0.65;
      const bandGain = ac.createGain();
      bandGain.gain.value = 0.09;
      src2.connect(band).connect(bandGain).connect(bus);

      const hum = ac.createOscillator();
      hum.type = 'sine';
      hum.frequency.value = 57;
      const humGain = ac.createGain();
      humGain.gain.value = 0.05;
      hum.connect(humGain).connect(bus);

      const lfo = ac.createOscillator();
      lfo.frequency.value = 0.15;
      const wobble = ac.createGain();
      wobble.gain.value = 0.07;
      lfo.connect(wobble);
      wobble.connect(airGain.gain);

      src.start(now);
      src2.start(now);
      hum.start(now);
      lfo.start(now);

      this.bus = bus;
      this.nodes = [src, src2, hum, lfo, low, high, band, airGain, bandGain, humGain, wobble];
      this.osc = hum;
      this.mode = 'fan';
    }

    startClean() {
      const ac = this.ctx;
      const now = ac.currentTime + 0.02;
      const bus = this._newBus(now);

      const osc = ac.createOscillator();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(165, now);

      const osc2 = ac.createOscillator();
      osc2.type = 'sine';
      osc2.frequency.setValueAtTime(166.8, now);

      const gain = ac.createGain();
      gain.gain.value = 0.55;
      osc.connect(gain).connect(bus);

      const gain2 = ac.createGain();
      gain2.gain.value = 0.06;
      osc2.connect(gain2).connect(bus);

      // Pulsing pressure for the water-eject phase.
      const am = ac.createOscillator();
      am.frequency.value = 3.1;
      const amDepth = ac.createGain();
      amDepth.gain.value = 0.14;
      am.connect(amDepth);
      amDepth.connect(gain.gain);

      // Water phase 0–14 s, dust sweep 14–20 s, water again 20–30 s.
      const water = now + 14;
      osc.frequency.setValueAtTime(165, now + 13.8);
      osc2.frequency.setValueAtTime(166.8, now + 13.8);

      const sweep = [
        [620, 14.6], [1600, 16.3], [2200, 17.6], [900, 19.0], [165, 20.2],
      ];
      for (const [freq, t] of sweep) {
        osc.frequency.exponentialRampToValueAtTime(freq, now + t);
        osc2.frequency.exponentialRampToValueAtTime(freq + 2, now + t);
      }

      amDepth.gain.setValueAtTime(0.14, now + 13.8);
      amDepth.gain.linearRampToValueAtTime(0.02, now + 14.6);
      amDepth.gain.setValueAtTime(0.02, now + 19.8);
      amDepth.gain.linearRampToValueAtTime(0.14, now + 20.4);

      gain.gain.setValueAtTime(0.55, now + 13.8);
      gain.gain.linearRampToValueAtTime(0.2, now + 14.6);
      gain.gain.setValueAtTime(0.2, now + 19.8);
      gain.gain.linearRampToValueAtTime(0.55, now + 20.4);

      osc.frequency.setValueAtTime(165, water);
      osc2.frequency.setValueAtTime(166.8, water);

      osc.start(now);
      osc2.start(now);
      am.start(now);

      this.bus = bus;
      this.nodes = [osc, osc2, gain, gain2, am, amDepth];
      this.osc = osc;
      this.mode = 'clean';
    }

    stop() {
      if (!this.ctx || !this.bus) return;
      const now = this.ctx.currentTime;
      const bus = this.bus;
      const nodes = this.nodes;
      try {
        bus.gain.cancelScheduledValues(now);
        bus.gain.setValueAtTime(Math.max(bus.gain.value, 0.0001), now);
        bus.gain.exponentialRampToValueAtTime(0.0001, now + 0.09);
      } catch (err) { /* node already gone */ }
      for (const node of nodes) {
        if (typeof node.stop === 'function') {
          try { node.stop(now + 0.12); } catch (err) { /* already stopped */ }
        }
      }
      window.setTimeout(() => {
        try { bus.disconnect(); } catch (err) { /* noop */ }
        for (const node of nodes) {
          try { node.disconnect(); } catch (err) { /* noop */ }
        }
      }, 230);
      this.bus = null;
      this.nodes = [];
      this.osc = null;
      this.mode = null;
    }
  }

  const audio = new ToneEngine(0.65);
  let busy = false;

  const state = {
    playing: false,
    mode: null,
    startedAt: 0,
    elapsed: 0,
  };

  const flame = {
    lit: true,
    level: 1,
    ember: 1,
    flash: 0,
    blowAt: Infinity,
  };

  /* ----------------------------------------------------------------- scene */
  const scene = {
    W: 0,
    H: 0,
    dpr: 1,
    layer: null,
    lctx: null,
    layout: null,
    t: 0,
    wind: 0,
    cool: 0,
    vibe: 0,
    smoke: [],
    sparks: [],
    motes: [],
    pointer: { x: 0, active: false },
  };

  function mulberry32(a) {
    return function rand() {
      a |= 0;
      a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function noise1(t, seed = 0) {
    return (
      Math.sin(t * 1.7 + seed) * 0.5 +
      Math.sin(t * 3.9 + seed * 2.1) * 0.3 +
      Math.sin(t * 8.3 + seed * 3.3) * 0.2
    );
  }

  function computeLayout(W, H) {
    const unit = Math.min(W, H * 1.18);
    const candleW = clamp(unit * 0.175, 46, 150);
    const candleH = candleW * 2.15;
    const tableY = H * 0.815;
    const plateY = tableY - candleW * 0.02;
    const bottomY = plateY - candleW * 0.09;
    const topY = bottomY - candleH;
    const rimRy = Math.max(5, candleW * 0.135);
    const wickTipY = topY - rimRy - candleW * 0.12;
    return { W, H, cx: W / 2, tableY, plateY, bottomY, topY, candleW, candleH, rimRy, wickTipY };
  }

  function resizeScene() {
    const rect = stage.getBoundingClientRect();
    const W = Math.max(280, Math.round(rect.width || stage.clientWidth));
    const H = Math.max(200, Math.round(rect.height || stage.clientHeight));
    const dpr = Math.min(2, window.devicePixelRatio || 1);

    scene.W = W;
    scene.H = H;
    scene.dpr = dpr;
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);

    const layer = document.createElement('canvas');
    layer.width = canvas.width;
    layer.height = canvas.height;
    scene.layer = layer;
    scene.lctx = layer.getContext('2d');
    scene.layout = computeLayout(W, H);

    const rnd = mulberry32(101);
    scene.motes = Array.from({ length: REDUCED ? 12 : 30 }, () => ({
      x: rnd() * W,
      y: rnd() * H,
      r: 0.4 + rnd() * 1.25,
      ph: rnd() * TAU,
      sp: 3 + rnd() * 8,
      drift: (rnd() - 0.5) * 5,
    }));

    drawStaticScene();
  }

  function drawStaticScene() {
    const c = scene.lctx;
    if (!c) return;
    const { W, H } = scene;
    c.setTransform(scene.dpr, 0, 0, scene.dpr, 0, 0);
    c.clearRect(0, 0, W, H);
    drawBackdrop(c);
    drawTable(c);
    drawVignette(c);
    drawPlate(c);
    drawCandle(c);
  }

  function drawBackdrop(c) {
    const { W, H } = scene;
    let g = c.createLinearGradient(0, 0, 0, H);
    g.addColorStop(0, '#06070a');
    g.addColorStop(0.5, '#0f0c09');
    g.addColorStop(1, '#171009');
    c.fillStyle = g;
    c.fillRect(0, 0, W, H);

    g = c.createRadialGradient(W * 0.5, H * 0.28, 0, W * 0.5, H * 0.28, Math.max(W, H) * 0.68);
    g.addColorStop(0, 'rgba(255,170,95,0.055)');
    g.addColorStop(0.5, 'rgba(120,70,35,0.018)');
    g.addColorStop(1, 'rgba(0,0,0,0)');
    c.fillStyle = g;
    c.fillRect(0, 0, W, H);
  }

  function drawTable(c) {
    const { W, H } = scene;
    const L = scene.layout;
    const y = L.tableY;

    let g = c.createLinearGradient(0, y, 0, H);
    g.addColorStop(0, '#302216');
    g.addColorStop(0.16, '#211710');
    g.addColorStop(1, '#0a0705');
    c.fillStyle = g;
    c.fillRect(0, y, W, H - y);

    const edge = c.createLinearGradient(0, 0, W, 0);
    edge.addColorStop(0, 'rgba(255,190,120,0)');
    edge.addColorStop(0.5, 'rgba(255,190,120,0.14)');
    edge.addColorStop(1, 'rgba(255,190,120,0)');
    c.strokeStyle = edge;
    c.lineWidth = 1;
    c.beginPath();
    c.moveTo(0, y + 0.5);
    c.lineTo(W, y + 0.5);
    c.stroke();

    c.save();
    c.beginPath();
    c.rect(0, y, W, H - y);
    c.clip();
    const rnd = mulberry32(19);
    for (let i = 0; i < 24; i++) {
      const gy = y + 4 + rnd() * (H - y);
      const amp = 0.8 + rnd() * 2.4;
      const freq = 0.004 + rnd() * 0.006;
      c.beginPath();
      c.moveTo(-10, gy);
      for (let x = -10; x <= W + 10; x += 32) {
        c.lineTo(x, gy + Math.sin(x * freq + i * 1.7) * amp);
      }
      c.strokeStyle = rnd() > 0.52
        ? `rgba(255,214,160,${0.018 + rnd() * 0.028})`
        : `rgba(0,0,0,${0.06 + rnd() * 0.09})`;
      c.lineWidth = 0.7 + rnd() * 1.1;
      c.stroke();
    }
    g = c.createRadialGradient(L.cx, y + 14, 0, L.cx, y + 14, Math.max(W * 0.42, 280));
    g.addColorStop(0, 'rgba(255,174,102,0.09)');
    g.addColorStop(0.45, 'rgba(255,150,80,0.03)');
    g.addColorStop(1, 'rgba(0,0,0,0)');
    c.fillStyle = g;
    c.fillRect(0, y, W, H - y);
    c.restore();
  }

  function drawVignette(c) {
    const { W, H } = scene;
    const g = c.createRadialGradient(
      W * 0.5, H * 0.46, Math.min(W, H) * 0.2,
      W * 0.5, H * 0.52, Math.max(W, H) * 0.72
    );
    g.addColorStop(0, 'rgba(0,0,0,0)');
    g.addColorStop(0.68, 'rgba(0,0,0,0.16)');
    g.addColorStop(1, 'rgba(0,0,0,0.6)');
    c.fillStyle = g;
    c.fillRect(0, 0, W, H);
  }

  function drawPlate(c) {
    const L = scene.layout;
    const { cx, candleW: w, plateY } = L;
    const rx = w * 1.32;
    const ry = w * 0.31;

    c.save();
    c.translate(cx, plateY + ry * 0.55);
    c.scale(1, 0.34);
    let g = c.createRadialGradient(0, 0, 0, 0, 0, rx * 1.5);
    g.addColorStop(0, 'rgba(0,0,0,0.62)');
    g.addColorStop(0.55, 'rgba(0,0,0,0.28)');
    g.addColorStop(1, 'rgba(0,0,0,0)');
    c.fillStyle = g;
    c.beginPath();
    c.arc(0, 0, rx * 1.5, 0, TAU);
    c.fill();
    c.restore();

    c.beginPath();
    c.ellipse(cx, plateY, rx, ry, 0, 0, TAU);
    g = c.createLinearGradient(cx - rx, plateY - ry, cx + rx, plateY + ry);
    g.addColorStop(0, '#4a3c31');
    g.addColorStop(0.35, '#2c221a');
    g.addColorStop(0.7, '#191310');
    g.addColorStop(1, '#342920');
    c.fillStyle = g;
    c.fill();
    c.strokeStyle = 'rgba(255,216,165,0.18)';
    c.lineWidth = 1;
    c.stroke();

    c.beginPath();
    c.ellipse(cx, plateY, rx * 0.92, ry * 0.8, 0, 0.15, Math.PI - 0.15);
    c.strokeStyle = 'rgba(255,226,184,0.1)';
    c.lineWidth = 2;
    c.stroke();

    c.beginPath();
    c.ellipse(cx, plateY - ry * 0.06, rx * 0.82, ry * 0.62, 0, 0, TAU);
    c.strokeStyle = 'rgba(255,220,170,0.05)';
    c.lineWidth = 1;
    c.stroke();
  }

  function drawCandle(c) {
    const L = scene.layout;
    const { cx, candleW: w, topY, bottomY, rimRy: ry, plateY } = L;
    const left = cx - w / 2;
    const right = cx + w / 2;
    const bodyH = bottomY - topY;

    // Contact shadow on the plate.
    c.save();
    c.translate(cx, bottomY + w * 0.03);
    c.scale(1, 0.26);
    let g = c.createRadialGradient(0, 0, 0, 0, 0, w * 0.85);
    g.addColorStop(0, 'rgba(0,0,0,0.55)');
    g.addColorStop(0.6, 'rgba(0,0,0,0.22)');
    g.addColorStop(1, 'rgba(0,0,0,0)');
    c.fillStyle = g;
    c.beginPath();
    c.arc(0, 0, w * 0.85, 0, TAU);
    c.fill();
    c.restore();

    // Body silhouette.
    const body = new Path2D();
    body.moveTo(left, topY);
    body.bezierCurveTo(left - w * 0.012, topY + bodyH * 0.4, left + w * 0.008, bottomY - bodyH * 0.2, left + w * 0.025, bottomY);
    body.quadraticCurveTo(cx, bottomY + ry * 0.95, right - w * 0.025, bottomY);
    body.bezierCurveTo(right - w * 0.008, bottomY - bodyH * 0.2, right + w * 0.012, topY + bodyH * 0.4, right, topY);
    body.closePath();

    g = c.createLinearGradient(left, 0, right, 0);
    g.addColorStop(0, '#6f5a3d');
    g.addColorStop(0.07, '#b49d74');
    g.addColorStop(0.22, '#e6d2a9');
    g.addColorStop(0.42, '#f7e8c4');
    g.addColorStop(0.55, '#fff2d2');
    g.addColorStop(0.72, '#efdcb4');
    g.addColorStop(0.9, '#bfa478');
    g.addColorStop(1, '#6b5539');
    c.fillStyle = g;
    c.fill(body);

    c.save();
    c.clip(body);

    let side = c.createLinearGradient(left, 0, left + w * 0.25, 0);
    side.addColorStop(0, 'rgba(43,28,12,0.5)');
    side.addColorStop(1, 'rgba(43,28,12,0)');
    c.fillStyle = side;
    c.fillRect(left, topY, w * 0.3, bodyH + w * 0.2);

    side = c.createLinearGradient(right - w * 0.24, 0, right, 0);
    side.addColorStop(0, 'rgba(43,28,12,0)');
    side.addColorStop(1, 'rgba(35,22,10,0.5)');
    c.fillStyle = side;
    c.fillRect(right - w * 0.26, topY, w * 0.3, bodyH + w * 0.2);

    // Wax striations.
    const rnd = mulberry32(7);
    for (let i = 0; i < 18; i++) {
      const x = left + rnd() * w;
      c.beginPath();
      c.moveTo(x, topY + ry * 0.4);
      c.bezierCurveTo(
        x + (rnd() - 0.5) * 3, topY + bodyH * 0.35,
        x + (rnd() - 0.5) * 3, topY + bodyH * 0.7,
        x + (rnd() - 0.5) * 4, bottomY - 2
      );
      c.strokeStyle = rnd() > 0.5
        ? `rgba(255,248,225,${0.05 + rnd() * 0.05})`
        : `rgba(110,80,45,${0.04 + rnd() * 0.04})`;
      c.lineWidth = 0.6 + rnd() * 1.1;
      c.stroke();
    }

    // Vertical light falloff: bright where the flame lives, darker at the base.
    const vertical = c.createLinearGradient(0, topY, 0, bottomY);
    vertical.addColorStop(0, 'rgba(255,230,180,0.12)');
    vertical.addColorStop(0.32, 'rgba(255,240,210,0.015)');
    vertical.addColorStop(0.72, 'rgba(38,22,9,0.15)');
    vertical.addColorStop(1, 'rgba(22,13,6,0.34)');
    c.fillStyle = vertical;
    c.fillRect(left, topY, w, bodyH);

    // Shade under the top rim.
    const topShade = c.createLinearGradient(0, topY, 0, topY + w * 0.2);
    topShade.addColorStop(0, 'rgba(90,60,25,0.32)');
    topShade.addColorStop(1, 'rgba(90,60,25,0)');
    c.fillStyle = topShade;
    c.fillRect(left, topY, w, w * 0.22);

    // Contact shadow at the base.
    const baseShade = c.createLinearGradient(0, bottomY - w * 0.18, 0, bottomY + ry);
    baseShade.addColorStop(0, 'rgba(60,38,16,0)');
    baseShade.addColorStop(1, 'rgba(45,26,10,0.45)');
    c.fillStyle = baseShade;
    c.fillRect(left, bottomY - w * 0.2, w, w * 0.3);

    // Static warm sheen near the wick.
    const sheen = c.createRadialGradient(cx, topY + w * 0.12, 0, cx, topY + w * 0.12, w * 0.7);
    sheen.addColorStop(0, 'rgba(255,196,120,0.16)');
    sheen.addColorStop(0.5, 'rgba(255,170,90,0.045)');
    sheen.addColorStop(1, 'rgba(255,150,70,0)');
    c.fillStyle = sheen;
    c.fillRect(left, topY, w, bodyH * 0.5);
    c.restore();

    drawDrips(c);

    // Rim.
    c.beginPath();
    c.ellipse(cx, topY, w / 2, ry, 0, 0, TAU);
    g = c.createLinearGradient(cx - w * 0.4, topY - ry, cx + w * 0.4, topY + ry);
    g.addColorStop(0, '#f3e3c0');
    g.addColorStop(0.5, '#e3cfa7');
    g.addColorStop(1, '#b59a6e');
    c.fillStyle = g;
    c.fill();
    c.strokeStyle = 'rgba(255,248,224,0.24)';
    c.lineWidth = 1;
    c.stroke();

    // Molten wax pool.
    c.beginPath();
    c.ellipse(cx, topY + ry * 0.06, w * 0.43, ry * 0.8, 0, 0, TAU);
    g = c.createRadialGradient(cx - w * 0.1, topY - ry * 0.35, 1, cx, topY, w * 0.45);
    g.addColorStop(0, '#fff8dd');
    g.addColorStop(0.55, '#f0dcb4');
    g.addColorStop(1, '#c9b084');
    c.fillStyle = g;
    c.fill();

    const poolShadow = c.createRadialGradient(cx, topY, 0, cx, topY, w * 0.2);
    poolShadow.addColorStop(0, 'rgba(120,80,30,0.32)');
    poolShadow.addColorStop(1, 'rgba(120,80,30,0)');
    c.fillStyle = poolShadow;
    c.fill();

    const poolGlint = c.createRadialGradient(cx - w * 0.08, topY - ry * 0.22, 0, cx - w * 0.08, topY - ry * 0.22, w * 0.24);
    poolGlint.addColorStop(0, 'rgba(255,252,236,0.4)');
    poolGlint.addColorStop(1, 'rgba(255,248,225,0)');
    c.fillStyle = poolGlint;
    c.fill();

    c.beginPath();
    c.ellipse(cx, topY, w * 0.49, ry * 0.9, 0, Math.PI * 1.05, Math.PI * 1.85);
    c.strokeStyle = 'rgba(255,250,230,0.22)';
    c.lineWidth = 1.2;
    c.stroke();

    // Wick.
    c.beginPath();
    c.moveTo(cx + 1.2, topY + ry * 0.12);
    c.bezierCurveTo(cx - 2.4, topY - ry * 0.55, cx + 2.2, topY - ry * 1.2, cx - 0.6, L.wickTipY);
    c.strokeStyle = '#241c15';
    c.lineWidth = Math.max(1.8, w * 0.017);
    c.lineCap = 'round';
    c.stroke();
    c.strokeStyle = 'rgba(255,230,190,0.1)';
    c.lineWidth = 0.6;
    c.stroke();
  }

  function drawDrips(c) {
    const L = scene.layout;
    const { cx, candleW: w, topY } = L;
    const drips = [
      { x: -0.34, len: 0.3, w: 0.075 },
      { x: -0.13, len: 0.17, w: 0.055 },
      { x: 0.08, len: 0.22, w: 0.05 },
      { x: 0.3, len: 0.13, w: 0.065 },
      { x: 0.43, len: 0.075, w: 0.038 },
    ];
    for (const drip of drips) {
      const x = cx + drip.x * w;
      const len = drip.len * w * 1.5;
      const dw = drip.w * w;
      const top = topY + 1.5;
      if (len < 3) continue;

      c.beginPath();
      c.moveTo(x - dw * 0.5, top);
      c.bezierCurveTo(x - dw * 0.6, top + len * 0.35, x - dw * 0.7, top + len * 0.7, x - dw * 0.45, top + len);
      c.quadraticCurveTo(x, top + len + dw * 0.85, x + dw * 0.45, top + len);
      c.bezierCurveTo(x + dw * 0.7, top + len * 0.7, x + dw * 0.6, top + len * 0.35, x + dw * 0.5, top);
      c.closePath();

      const g = c.createLinearGradient(x - dw, 0, x + dw, 0);
      g.addColorStop(0, 'rgba(196,171,126,0.95)');
      g.addColorStop(0.4, '#f6e7c5');
      g.addColorStop(0.75, '#ead7b0');
      g.addColorStop(1, '#bda078');
      c.fillStyle = g;
      c.fill();

      c.beginPath();
      c.moveTo(x - dw * 0.2, top + 2);
      c.quadraticCurveTo(x - dw * 0.34, top + len * 0.6, x - dw * 0.1, top + len * 0.84);
      c.strokeStyle = 'rgba(255,250,230,0.18)';
      c.lineWidth = 0.7;
      c.stroke();
    }
  }

  /* -------------------------------------------------------- dynamic scene */
  function render(t) {
    const c = ctx;
    const { W, H } = scene;
    const L = scene.layout;
    if (!c || !scene.layer || !L) return;

    c.setTransform(scene.dpr, 0, 0, scene.dpr, 0, 0);
    c.clearRect(0, 0, W, H);
    c.drawImage(scene.layer, 0, 0, W, H);

    if (scene.cool > 0.01) drawCoolWash(c, t);
    drawAirflow(c, t);
    drawBassRipples(c, t);

    const lvl = flame.level;
    const gust = scene.wind;
    const gutter = 0.5 + 0.5 * Math.sin(t * 18.7 + Math.sin(t * 3.1));
    const flick = noise1(t * 1.6, 2.4);
    const baseH = L.candleW * 1.06;
    const baseW = L.candleW * 0.33;
    const h = Math.max(0, baseH * lvl * (0.94 + flick * 0.06) * (1 - gust * (0.14 + 0.12 * gutter)) * (1 + flame.flash * 0.18));
    const w = Math.max(0, baseW * lvl * (0.97 + noise1(t * 2.9, 8) * 0.05) * (1 + gust * 0.03));

    const calmLean = 0.018 * Math.sin(t * 1.4) + 0.01 * Math.sin(t * 2.7 + 1.3);
    const windLean = gust * (0.3 + 0.08 * Math.sin(t * 7.3 + 1.1));
    const jitter = scene.vibe * 0.012 * Math.sin(t * 41);
    const pointerLean = scene.pointer.active ? scene.pointer.x * 0.02 : 0;
    const tipDx = (calmLean + windLean + jitter + pointerLean) * lvl * baseH;

    const bx = L.cx;
    const by = L.wickTipY;
    const energy = state.playing ? audio.level() : 0;

    if (lvl > 0.01) drawWarmGlow(c, t, lvl, gust, energy);

    if (lvl > 0.004) drawFlame(c, bx, by, h, w, tipDx);

    drawWickEmber(c);
    drawSmoke(c);
    drawSparks(c);
    drawMotes(c, t);
    drawRelightFlash(c);
  }

  function drawWarmGlow(c, t, lvl, gust, energy) {
    const { W, H } = scene;
    const L = scene.layout;
    const { cx, candleW: w, topY, tableY } = L;
    const pulse = 1 + 0.1 * Math.sin(t * 7.3) + 0.05 * Math.sin(t * 13.1 + 1);
    const boost = 1 + Math.min(0.45, energy * 0.8);

    c.save();
    c.globalCompositeOperation = 'screen';

    let g = c.createRadialGradient(cx, topY, 0, cx, topY, Math.max(W, H) * 0.52);
    g.addColorStop(0, `rgba(255,150,60,${0.13 * lvl * pulse * boost})`);
    g.addColorStop(0.25, `rgba(255,120,45,${0.055 * lvl * boost})`);
    g.addColorStop(0.62, `rgba(120,60,25,${0.018 * lvl})`);
    g.addColorStop(1, 'rgba(0,0,0,0)');
    c.fillStyle = g;
    c.fillRect(0, 0, W, H);

    g = c.createRadialGradient(cx, topY - w * 0.22, 0, cx, topY - w * 0.22, w * (2.2 + gust * 0.35));
    g.addColorStop(0, `rgba(255,208,145,${0.2 * lvl * pulse})`);
    g.addColorStop(0.35, `rgba(255,150,60,${0.07 * lvl})`);
    g.addColorStop(1, 'rgba(255,100,30,0)');
    c.fillStyle = g;
    c.fillRect(cx - w * 4, topY - w * 5, w * 8, w * 8);

    // Light wrapping the top of the wax.
    c.save();
    c.beginPath();
    c.rect(cx - w * 0.5, topY - 8, w, L.bottomY - topY + 8);
    c.clip();
    g = c.createRadialGradient(cx, topY + w * 0.06, 0, cx, topY + w * 0.06, w * 0.95);
    g.addColorStop(0, `rgba(255,196,120,${0.16 * lvl})`);
    g.addColorStop(0.55, `rgba(255,170,90,${0.045 * lvl})`);
    g.addColorStop(1, 'rgba(255,150,70,0)');
    c.fillStyle = g;
    c.fillRect(cx - w * 0.5, topY - 8, w, L.bottomY - topY + 8);
    c.restore();

    // Pool of light on the table.
    c.save();
    c.translate(cx, tableY + w * 0.09);
    c.scale(1, 0.3);
    g = c.createRadialGradient(0, 0, 0, 0, 0, w * 3.2);
    g.addColorStop(0, `rgba(255,162,78,${0.11 * lvl})`);
    g.addColorStop(1, 'rgba(255,120,40,0)');
    c.fillStyle = g;
    c.beginPath();
    c.arc(0, 0, w * 3.2, 0, TAU);
    c.fill();
    c.restore();

    c.restore();
  }

  function flamePath(c, bx, by, h, w, tipDx) {
    const tipX = bx + tipDx;
    const tipY = by - h;
    c.beginPath();
    c.moveTo(tipX, tipY);
    c.bezierCurveTo(tipX + w * 0.4, by - h * 0.6, bx + w * 0.62, by - h * 0.24, bx + w * 0.46, by - h * 0.04);
    c.quadraticCurveTo(bx, by + h * 0.09, bx - w * 0.46, by - h * 0.04);
    c.bezierCurveTo(bx - w * 0.62, by - h * 0.24, tipX - w * 0.4, by - h * 0.6, tipX, tipY);
    c.closePath();
  }

  function drawFlame(c, bx, by, h, w, tipDx) {
    if (h < 1) return;
    c.save();

    // Soft outer mantle.
    c.globalCompositeOperation = 'screen';
    flamePath(c, bx, by + h * 0.02, h * 1.1, w * 1.25, tipDx * 1.04);
    let g = c.createRadialGradient(bx, by - h * 0.28, 0, bx, by - h * 0.28, h * 1.1);
    g.addColorStop(0, 'rgba(255,186,96,0.16)');
    g.addColorStop(0.55, 'rgba(255,130,45,0.075)');
    g.addColorStop(1, 'rgba(255,90,20,0)');
    c.fillStyle = g;
    c.fill();

    // Main body.
    c.globalCompositeOperation = 'source-over';
    flamePath(c, bx, by, h, w, tipDx);
    g = c.createRadialGradient(bx, by - h * 0.3, 0, bx + tipDx * 0.3, by - h * 0.3, h * 1.02);
    g.addColorStop(0, 'rgba(255,252,232,0.94)');
    g.addColorStop(0.18, 'rgba(255,238,175,0.95)');
    g.addColorStop(0.45, 'rgba(255,198,94,0.9)');
    g.addColorStop(0.7, 'rgba(255,150,52,0.78)');
    g.addColorStop(0.88, 'rgba(255,100,22,0.36)');
    g.addColorStop(1, 'rgba(255,84,14,0)');
    c.fillStyle = g;
    c.fill();

    // Faint hot rim.
    c.globalCompositeOperation = 'screen';
    flamePath(c, bx, by, h, w, tipDx);
    c.strokeStyle = 'rgba(255,120,35,0.16)';
    c.lineWidth = 1.2;
    c.stroke();

    // Inner core.
    const ch = h * 0.5;
    const cw = w * 0.4;
    if (ch > 2) {
      c.globalCompositeOperation = 'lighter';
      flamePath(c, bx, by - h * 0.12, ch, cw, tipDx * 0.8);
      g = c.createRadialGradient(bx, by - h * 0.12 - ch * 0.3, 0, bx, by - h * 0.12 - ch * 0.3, ch * 0.85);
      g.addColorStop(0, 'rgba(255,255,250,0.72)');
      g.addColorStop(0.3, 'rgba(255,246,198,0.42)');
      g.addColorStop(0.65, 'rgba(255,225,145,0.13)');
      g.addColorStop(1, 'rgba(255,220,140,0)');
      c.fillStyle = g;
      c.fill();
    }

    // Blue root, kept subtle.
    if (h > 6) {
      c.globalCompositeOperation = 'lighter';
      g = c.createRadialGradient(bx, by - h * 0.015, 0, bx, by - h * 0.015, w * 0.7);
      g.addColorStop(0, 'rgba(120,175,255,0.26)');
      g.addColorStop(0.5, 'rgba(60,110,235,0.08)');
      g.addColorStop(1, 'rgba(40,80,210,0)');
      c.fillStyle = g;
      c.beginPath();
      c.ellipse(bx, by - h * 0.005, w * 0.46, h * 0.06, 0, 0, TAU);
      c.fill();
    }

    c.restore();
  }

  function drawWickEmber(c) {
    const L = scene.layout;
    if (!L) return;
    const ember = flame.ember;
    if (flame.level > 0.28 || ember <= 0.01) return;
    const { cx, wickTipY } = L;
    const r = 2.5 + ember * 5;
    c.save();
    c.globalCompositeOperation = 'lighter';
    const g = c.createRadialGradient(cx, wickTipY, 0, cx, wickTipY, r * 2.8);
    g.addColorStop(0, `rgba(255,176,78,${0.55 * ember})`);
    g.addColorStop(0.4, `rgba(255,92,26,${0.22 * ember})`);
    g.addColorStop(1, 'rgba(255,70,10,0)');
    c.fillStyle = g;
    c.beginPath();
    c.arc(cx, wickTipY, r * 2.8, 0, TAU);
    c.fill();
    c.fillStyle = `rgba(255,218,155,${0.8 * ember})`;
    c.beginPath();
    c.arc(cx, wickTipY, Math.max(0.8, r * 0.18), 0, TAU);
    c.fill();
    c.restore();
  }

  function spawnSmoke(count) {
    const L = scene.layout;
    if (!L) return;
    for (let i = 0; i < count; i++) {
      const life = 2.6 + Math.random() * 2.8;
      scene.smoke.push({
        x: L.cx + (Math.random() - 0.5) * L.candleW * 0.24,
        y: L.wickTipY + (Math.random() - 0.5) * 5,
        vx: (Math.random() - 0.5) * 14,
        vy: -16 - Math.random() * 20,
        r: 4 + Math.random() * 8,
        life,
        max: life,
        seed: Math.random() * TAU,
        t: 0,
      });
    }
    if (scene.smoke.length > 90) scene.smoke.splice(0, scene.smoke.length - 90);
  }

  function spawnSparks(count) {
    const L = scene.layout;
    if (!L) return;
    for (let i = 0; i < count; i++) {
      const life = 0.5 + Math.random() * 0.8;
      scene.sparks.push({
        x: L.cx + (Math.random() - 0.5) * 7,
        y: L.wickTipY + (Math.random() - 0.5) * 4,
        vx: (Math.random() - 0.5) * 46,
        vy: -24 - Math.random() * 52,
        life,
        max: life,
      });
    }
  }

  function drawSmoke(c) {
    if (!scene.smoke.length) return;
    c.save();
    c.globalCompositeOperation = 'screen';
    for (const p of scene.smoke) {
      const a = clamp(p.life / p.max, 0, 1);
      if (a <= 0) continue;
      const g = c.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r * 2.2);
      g.addColorStop(0, `rgba(202,196,188,${0.13 * a})`);
      g.addColorStop(0.45, `rgba(156,150,142,${0.07 * a})`);
      g.addColorStop(1, 'rgba(120,115,110,0)');
      c.fillStyle = g;
      c.beginPath();
      c.arc(p.x, p.y, p.r * 2.2, 0, TAU);
      c.fill();
    }
    c.restore();
  }

  function drawSparks(c) {
    if (!scene.sparks.length) return;
    c.save();
    c.globalCompositeOperation = 'lighter';
    for (const s of scene.sparks) {
      const a = clamp(s.life / s.max, 0, 1);
      c.fillStyle = `rgba(255,${Math.round(150 + 70 * a)},${Math.round(70 * a)},${a})`;
      c.beginPath();
      c.arc(s.x, s.y, 0.8 + a * 1.2, 0, TAU);
      c.fill();
    }
    c.restore();
  }

  function drawMotes(c, t) {
    c.save();
    c.globalCompositeOperation = 'screen';
    const baseA = flame.lit ? 0.14 : 0.05;
    for (const m of scene.motes) {
      const tw = 0.35 + 0.65 * (0.5 + 0.5 * Math.sin(t * 1.2 + m.ph));
      c.fillStyle = `rgba(255,224,182,${(baseA * tw).toFixed(3)})`;
      c.beginPath();
      c.arc(m.x, m.y, m.r, 0, TAU);
      c.fill();
    }
    c.restore();
  }

  function drawCoolWash(c, t) {
    const { W, H } = scene;
    c.save();
    c.globalCompositeOperation = 'screen';
    const g = c.createLinearGradient(0, 0, 0, H);
    g.addColorStop(0, `rgba(118,176,236,${0.06 * scene.cool})`);
    g.addColorStop(0.55, `rgba(90,140,205,${0.024 * scene.cool})`);
    g.addColorStop(1, 'rgba(0,0,0,0)');
    c.fillStyle = g;
    c.fillRect(0, 0, W, H);
    c.restore();
  }

  function drawAirflow(c, t) {
    if (scene.cool < 0.02) return;
    const { W, H } = scene;
    c.save();
    c.globalCompositeOperation = 'screen';
    for (let i = 0; i < 6; i++) {
      const ph = (t * (0.1 + i * 0.012) + i * 0.17) % 1;
      const x = -W * 0.25 + ph * W * 1.5;
      const y = H * (0.16 + (i % 4) * 0.14) + Math.sin(t * 0.7 + i) * 8;
      const len = W * (0.08 + (i % 3) * 0.025);
      const lg = c.createLinearGradient(x, y, x + len, y);
      lg.addColorStop(0, 'rgba(160,215,255,0)');
      lg.addColorStop(0.5, `rgba(170,220,255,${0.07 * scene.cool})`);
      lg.addColorStop(1, 'rgba(160,215,255,0)');
      c.strokeStyle = lg;
      c.lineWidth = 1.1;
      c.beginPath();
      c.moveTo(x, y);
      c.bezierCurveTo(x + len * 0.3, y - 10, x + len * 0.65, y + 10, x + len, y);
      c.stroke();
    }
    c.restore();
  }

  function drawBassRipples(c, t) {
    if (scene.vibe < 0.03) return;
    const { W, H } = scene;
    const L = scene.layout;
    c.save();
    c.beginPath();
    c.rect(0, L.tableY - 4, W, H - L.tableY + 4);
    c.clip();
    for (let i = 0; i < 4; i++) {
      const ph = (t * 0.6 + i * 0.25) % 1;
      const rx = L.candleW * (1.4 + ph * 4.2);
      const ry = rx * 0.26;
      const a = (1 - ph) * 0.17 * scene.vibe;
      c.beginPath();
      c.ellipse(L.cx, L.tableY + L.candleW * 0.06, rx, ry, 0, 0, TAU);
      c.strokeStyle = `rgba(127,227,192,${a})`;
      c.lineWidth = 1;
      c.stroke();
    }
    c.restore();

    const g = c.createLinearGradient(0, H - 90, 0, H);
    g.addColorStop(0, 'rgba(127,227,192,0)');
    g.addColorStop(1, `rgba(127,227,192,${0.055 * scene.vibe})`);
    c.fillStyle = g;
    c.fillRect(0, H - 90, W, 90);
  }

  function drawRelightFlash(c) {
    if (flame.flash <= 0.01) return;
    const L = scene.layout;
    c.save();
    c.globalCompositeOperation = 'lighter';
    const r = L.candleW * (1.2 + (1 - flame.flash) * 1.5);
    const g = c.createRadialGradient(L.cx, L.wickTipY, 0, L.cx, L.wickTipY, r);
    g.addColorStop(0, `rgba(255,240,200,${0.34 * flame.flash})`);
    g.addColorStop(0.4, `rgba(255,170,70,${0.13 * flame.flash})`);
    g.addColorStop(1, 'rgba(255,120,30,0)');
    c.fillStyle = g;
    c.beginPath();
    c.arc(L.cx, L.wickTipY, r, 0, TAU);
    c.fill();
    c.restore();
  }

  function updateScene(dt) {
    const target = flame.lit ? 1 : 0;
    const speed = flame.lit ? 6.5 : 12;
    flame.level += (target - flame.level) * (1 - Math.exp(-dt * speed));
    if (flame.level < 0.001) flame.level = 0;
    if (flame.level > 0.999) flame.level = 1;

    flame.flash = Math.max(0, flame.flash - dt * 1.8);
    if (!flame.lit) flame.ember = Math.max(0, flame.ember - dt * 0.26);

    let windTarget = 0;
    let coolTarget = 0;
    let vibeTarget = 0;
    if (state.playing) {
      if (state.mode === 'flame') windTarget = 1;
      else if (state.mode === 'fan') { windTarget = 0.62; coolTarget = 1; }
      else if (state.mode === 'clean') { windTarget = 0.05; vibeTarget = 1; }
    }
    scene.wind += (windTarget - scene.wind) * (1 - Math.exp(-dt * 3.1));
    scene.cool += (coolTarget - scene.cool) * (1 - Math.exp(-dt * 1.4));
    scene.vibe += (vibeTarget - scene.vibe) * (1 - Math.exp(-dt * 2.6));

    for (const p of scene.smoke) {
      p.t += dt;
      p.life -= dt;
      p.x += (p.vx + Math.sin(p.t * 1.8 + p.seed) * 7) * dt;
      p.y += p.vy * dt;
      p.vy *= 1 - dt * 0.24;
      p.r += 8 * dt;
    }
    scene.smoke = scene.smoke.filter((p) => p.life > 0);

    for (const s of scene.sparks) {
      s.life -= dt;
      s.vy += 24 * dt;
      s.x += s.vx * dt;
      s.y += s.vy * dt;
    }
    scene.sparks = scene.sparks.filter((s) => s.life > 0);

    for (const m of scene.motes) {
      m.y -= m.sp * (0.25 + (flame.lit ? 0.85 : 0.2)) * dt;
      m.x += (m.drift + Math.sin(scene.t * 0.6 + m.ph) * 4 + scene.wind * 9) * dt;
      if (m.y < -4) { m.y = scene.H + 4; m.x = Math.random() * scene.W; }
      if (m.x < -4) m.x = scene.W + 4;
      if (m.x > scene.W + 4) m.x = -4;
    }
  }

  /* -------------------------------------------------------------------- UI */
  function formatTime(seconds) {
    const s = Math.ceil(seconds);
    if (s >= 60) return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
    return `${s}s`;
  }

  function frequencyLabel() {
    if (!state.playing) return '';
    if (state.mode === 'flame') return `${Math.round(audio.frequency || 44)} Hz`;
    if (state.mode === 'fan') return 'Airflow';
    return state.elapsed < 14 ? '165 Hz' : state.elapsed < 20.4 ? 'Dust sweep' : '165 Hz';
  }

  function captionFor() {
    if (state.playing) {
      if (state.mode === 'flame') {
        return flame.lit ? 'Deep bass · hold steady on the flame' : 'Flame out — try it on your candle';
      }
      if (state.mode === 'fan') return 'A steady breeze, no blades';
      return 'Cleaning pulses · point the speaker down';
    }
    return flame.lit ? 'Aim a real speaker at the flame' : 'Candle’s out';
  }

  function setCaption(text) {
    if (captionEl.textContent !== text) captionEl.textContent = text;
  }

  function updateUI() {
    const active = state.playing ? state.mode : null;
    for (const [mode, el] of modeEls) {
      const isActive = mode === active;
      el.classList.toggle('is-active', isActive);
      el.setAttribute('aria-pressed', String(isActive));
      const timer = el.querySelector('.mode-timer');
      const fill = el.querySelector('.mode-fill');
      if (isActive) {
        const remain = Math.max(0, MODES[mode].duration - state.elapsed);
        timer.textContent = formatTime(remain);
        fill.style.width = `${clamp((1 - state.elapsed / MODES[mode].duration) * 100, 0, 100).toFixed(1)}%`;
      } else {
        timer.textContent = '';
        fill.style.width = '0%';
      }
    }

    statusEl.dataset.mode = active || 'idle';
    statusText.textContent = active ? MODES[active].status : 'Ready';
    statusFreq.textContent = active ? frequencyLabel() : '';
    stopBtn.disabled = !state.playing;
    relightBtn.hidden = flame.lit;
    setCaption(captionFor());
  }

  async function startMode(mode) {
    if (busy || !MODES[mode]) return;
    busy = true;
    try {
      await audio.ensure();
      audio.stop();
      if (mode === 'flame') audio.startFlame();
      else if (mode === 'fan') audio.startFan();
      else audio.startClean();

      state.playing = true;
      state.mode = mode;
      state.startedAt = performance.now();
      state.elapsed = 0;
      if (mode === 'flame') {
        flame.blowAt = flame.lit ? performance.now() + 3400 : Infinity;
      } else {
        flame.blowAt = Infinity;
      }
      updateUI();
    } catch (err) {
      console.error('[candle-blower] audio failed to start', err);
      setCaption('Audio couldn’t start — check your browser’s sound permissions.');
    } finally {
      busy = false;
    }
  }

  function stopAll() {
    audio.stop();
    state.playing = false;
    state.mode = null;
    state.elapsed = 0;
    flame.blowAt = Infinity;
    updateUI();
  }

  async function toggleMode(mode) {
    if (state.playing && state.mode === mode) {
      stopAll();
      return;
    }
    await startMode(mode);
  }

  function extinguish() {
    if (!flame.lit) return;
    flame.lit = false;
    flame.blowAt = Infinity;
    flame.ember = 1;
    spawnSmoke(16);
    spawnSparks(10);
    updateUI();
  }

  function relight() {
    if (flame.lit) return;
    flame.lit = true;
    flame.level = Math.max(flame.level, 0.02);
    flame.ember = 1;
    flame.flash = 1;
    scene.smoke.length = 0;
    flame.blowAt = state.playing && state.mode === 'flame'
      ? performance.now() + 2000
      : Infinity;
    updateUI();
  }

  /* --------------------------------------------------------------- wiring */
  for (const [mode, el] of modeEls) {
    el.addEventListener('click', () => { toggleMode(mode); });
  }

  stopBtn.addEventListener('click', stopAll);
  relightBtn.addEventListener('click', relight);

  function downloadSelf() {
    const clone = document.documentElement.cloneNode(true);
    clone.querySelectorAll('.mode').forEach((el) => {
      el.classList.remove('is-active');
      el.setAttribute('aria-pressed', 'false');
      const timer = el.querySelector('.mode-timer');
      const fill = el.querySelector('.mode-fill');
      if (timer) timer.textContent = '';
      if (fill) fill.style.width = '0%';
    });
    const cloneStatus = clone.querySelector('#status');
    if (cloneStatus) cloneStatus.dataset.mode = 'idle';
    const cloneStatusText = clone.querySelector('#statusText');
    if (cloneStatusText) cloneStatusText.textContent = 'Ready';
    const cloneStatusFreq = clone.querySelector('#statusFreq');
    if (cloneStatusFreq) cloneStatusFreq.textContent = '';
    const cloneStop = clone.querySelector('#stopBtn');
    if (cloneStop) cloneStop.disabled = true;
    const cloneRelight = clone.querySelector('#relightBtn');
    if (cloneRelight) cloneRelight.hidden = true;
    const cloneCaption = clone.querySelector('#stageCaption');
    if (cloneCaption) cloneCaption.textContent = 'Aim a real speaker at the flame';
    const clonePanel = clone.querySelector('#infoPanel');
    if (clonePanel) clonePanel.hidden = true;
    const cloneInfoBtn = clone.querySelector('#infoBtn');
    if (cloneInfoBtn) cloneInfoBtn.setAttribute('aria-expanded', 'false');
    const cloneVolume = clone.querySelector('#volume');
    if (cloneVolume) {
      cloneVolume.value = volumeEl.value;
      cloneVolume.setAttribute('value', volumeEl.value);
      cloneVolume.style.setProperty('--vol', `${volumeEl.value}%`);
    }
    const cloneVolumeOut = clone.querySelector('#volumeOut');
    if (cloneVolumeOut) cloneVolumeOut.textContent = volumeOut.textContent;

    const html = '<!DOCTYPE html>\n' + clone.outerHTML;
    const blob = new Blob([html], { type: 'text/html;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = 'candle-blower.html';
    document.body.appendChild(link);
    link.click();
    link.remove();
    window.setTimeout(() => URL.revokeObjectURL(url), 2000);
  }

  downloadBtn.addEventListener('click', downloadSelf);

  volumeEl.addEventListener('input', () => {
    const value = Number(volumeEl.value);
    audio.setVolume(value / 100);
    volumeOut.textContent = `${value}%`;
    volumeEl.style.setProperty('--vol', `${value}%`);
  });
  volumeEl.style.setProperty('--vol', `${volumeEl.value}%`);
  audio.setVolume(Number(volumeEl.value) / 100);
  volumeOut.textContent = `${volumeEl.value}%`;

  stage.addEventListener('click', () => {
    if (!flame.lit) relight();
  });

  stage.addEventListener('pointermove', (e) => {
    const rect = stage.getBoundingClientRect();
    scene.pointer.x = clamp(((e.clientX - rect.left) / rect.width) * 2 - 1, -1, 1);
    scene.pointer.active = true;
  });
  stage.addEventListener('pointerleave', () => {
    scene.pointer.active = false;
  });

  function setInfo(open) {
    infoPanel.hidden = !open;
    infoBtn.setAttribute('aria-expanded', String(open));
    if (open) infoClose.focus({ preventScroll: true });
  }

  infoBtn.addEventListener('click', () => setInfo(infoPanel.hidden));
  infoClose.addEventListener('click', () => setInfo(false));
  document.addEventListener('click', (e) => {
    if (infoPanel.hidden) return;
    if (infoPanel.contains(e.target) || infoBtn.contains(e.target)) return;
    setInfo(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !infoPanel.hidden) {
      setInfo(false);
      infoBtn.focus({ preventScroll: true });
    }
  });

  document.addEventListener('visibilitychange', () => {
    if (document.hidden && state.playing) stopAll();
  });

  const resizeObserver = new ResizeObserver(() => resizeScene());
  resizeObserver.observe(stage);
  window.addEventListener('orientationchange', () => {
    window.setTimeout(resizeScene, 220);
  });

  /* ----------------------------------------------------------------- loop */
  let previous = performance.now();
  let uiClock = 0;

  function frame(now) {
    const dt = Math.min(0.05, (now - previous) / 1000);
    previous = now;
    scene.t += dt;

    if (state.playing) {
      state.elapsed = (now - state.startedAt) / 1000;
      if (state.elapsed >= MODES[state.mode].duration) {
        stopAll();
      } else if (state.mode === 'flame' && flame.lit && now >= flame.blowAt) {
        extinguish();
      }
      if (state.playing && now - uiClock > 100) {
        uiClock = now;
        updateUI();
      }
    }

    updateScene(dt);
    render(scene.t);
    requestAnimationFrame(frame);
  }

  resizeScene();
  updateUI();
  requestAnimationFrame(frame);
})();

  </script>
</body>
</html>
